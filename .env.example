# Local SQLite database used by Prisma
DATABASE_URL="file:./dev.db"

# ============================================
# AI PROVIDER
# ============================================

# Use OpenAI for DealWatch
DEALWATCH_AI_PROVIDER="openai"

# ============================================
# API KEYS
# ============================================

# Keep your Gemini key if you want to benchmark Gemini later
GEMINI_API_KEY="YOUR_REAL_GEMINI_API_KEY"

# OpenAI API key
OPENAI_API_KEY="YOUR_REAL_OPENAI_API_KEY"

# ============================================
# MODELS
# ============================================

# Email-thread extraction model
DEALWATCH_ANALYSIS_MODEL="gpt-5-nano"

# CRE negotiation/document extraction model
DEALWATCH_NEGOTIATION_MODEL="gpt-5-nano"

# ============================================
# EVALUATION
# ============================================

# OpenAI does not need the 13-second Gemini free-tier delay
DEALWATCH_EVAL_REQUEST_INTERVAL_MS="0"

# Only enable when intentionally running real API integration tests
RUN_DEALWATCH_INTEGRATION_TESTS="0"