# Local SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"

# Required for email-thread and negotiation-term extraction.
OPENAI_API_KEY="your-openai-api-key"

# Optional model overrides. Both default to gpt-4o-mini.
DEALWATCH_ANALYSIS_MODEL="gpt-4o-mini"
DEALWATCH_NEGOTIATION_MODEL="gpt-4o-mini"

# Set to 1 only when intentionally running tests that call the OpenAI API.
RUN_DEALWATCH_INTEGRATION_TESTS="0"
