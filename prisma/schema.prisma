generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deal {
  id             String   @id @default(cuid())
  name           String
  company        String
  property       String
  estimatedValue Float?
  stage          String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// Firm boundary. Existing rows are backfilled to the Default workspace.
  workspaceId    String
  /// Canonical building this deal concerns. Null until explicitly linked.
  propertyId     String?

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id])
  /// Relation name differs from the legacy string column `property`.
  canonicalProperty Property?                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  threads           Thread[]
  obligations       Obligation[]
  events            DealEvent[]
  negotiationRounds NegotiationRound[]
  documents         Document[]
  participations    DealParticipation[]
  entityObservations EntityObservation[]
  relationshipObservations RelationshipObservation[] @relation("RelationshipObservationDeal")
  relationshipObservationContexts RelationshipObservation[] @relation("RelationshipObservationContextDeal")
  relationshipPromotions RelationshipPromotion[]

  @@index([workspaceId])
  @@index([propertyId])
}

/// First-class CRE document. Independent of any one negotiation round so a
/// later phase can attach entity or relationship observations to the same
/// pages. This model stores no Person, Company, or Property ids.
enum DocumentType {
  LOI
  PROPOSAL
  COUNTERPROPOSAL
  TERM_SHEET
  AMENDMENT
  RENEWAL_PROPOSAL
  OTHER
}

enum DocumentIngestionStatus {
  UPLOADED
  EXTRACTING
  READY
  ANALYZING
  COMPLETE
  FAILED
}

/// Graph observation extraction is independent of negotiation analysis.
enum GraphExtractionStatus {
  NOT_RUN
  SUCCEEDED
  FAILED
}

enum EvidenceProvenanceStatus {
  EXACT
  AMBIGUOUS
  UNLOCATED
}

model Document {
  id               String                  @id @default(cuid())
  dealId           String
  filename         String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  documentType     DocumentType
  documentDate     DateTime?
  negotiationSide  String?
  ingestionStatus  DocumentIngestionStatus @default(UPLOADED)
  failureCode      String?
  failureReason    String?
  /// Relative storage key. Never an absolute filesystem path.
  storageKey       String
  pageCount        Int?
  graphExtractionStatus GraphExtractionStatus @default(NOT_RUN)
  graphFailureCode      String?
  graphFailureReason    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  deal              Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  pages             DocumentPage[]
  negotiationRounds NegotiationRound[]
  entityObservations EntityObservation[]
  relationshipObservations RelationshipObservation[]
  graphExtractionRuns GraphExtractionRun[]

  @@unique([dealId, sha256])
  @@index([dealId, createdAt])
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageNumber Int
  text       String
  createdAt  DateTime @default(now())

  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  terms    NegotiationTerm[]
  entityObservations EntityObservation[]
  relationshipObservations RelationshipObservation[]

  @@unique([documentId, pageNumber])
}

model Thread {
  id           String   @id @default(cuid())
  dealId       String
  subject      String
  participants String // JSON array stored as string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  sender     String
  recipients String // JSON array stored as string
  sentAt     DateTime
  body       String

  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  obligations Obligation[]
  events      DealEvent[]
  entityObservations EntityObservation[]
  relationshipObservations RelationshipObservation[]
}

model Obligation {
  id            String    @id @default(cuid())
  dealId        String
  messageId     String?
  owner         String
  counterparty  String?
  description   String
  dueAt         DateTime?
  status        String    @default("OPEN")
  confidence    Float
  evidenceQuote String
  createdAt     DateTime  @default(now())

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id])
}

model DealEvent {
  id            String   @id @default(cuid())
  dealId        String
  messageId     String?
  type          String
  description   String
  occurredAt    DateTime
  confidence    Float
  evidenceQuote String

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id])
}

model NegotiationRound {
  id           String   @id @default(cuid())
  dealId       String
  side         String
  roundNumber  Int
  documentName String
  documentText String
  documentDate DateTime
  sourceType   String   @default("PASTED_TEXT")
  documentId   String?
  createdAt    DateTime @default(now())

  deal     Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  terms    NegotiationTerm[]

  @@unique([dealId, side, roundNumber])
  @@index([dealId, documentDate])
  @@index([documentId])
}

model NegotiationTerm {
  id                String   @id @default(cuid())
  roundId           String
  canonicalType     String
  normalizedValue   String?
  normalizedNumeric Float?
  normalizedUnit    String?
  rawValue          String
  status            String
  side              String
  roundNumber       Int
  confidence        Float
  evidenceQuote       String
  sourceLocation      String?
  /// Set only when the evidence quote matches exactly one extracted page.
  documentPageId      String?
  evidenceStartOffset Int?
  evidenceEndOffset   Int?
  provenanceStatus    EvidenceProvenanceStatus?
  createdAt           DateTime @default(now())
  /// Typed CRE structured payload (JSON). Validated at the application layer
  /// via Zod (see lib/ai/negotiation/payloads.ts). Null for legacy rows and
  /// for term types that carry no structured representation
  /// (PREMISES_RSF, LEASE_TERM, SECURITY_DEPOSIT, RENT_STRUCTURE,
  /// DELIVERY_CONDITION, ASSIGNMENT_SUBLETTING). Never mutated after creation.
  structuredPayload Json?

  round        NegotiationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  documentPage DocumentPage?    @relation(fields: [documentPageId], references: [id], onDelete: SetNull)

  @@index([roundId, canonicalType])
  @@index([documentPageId])
  @@index([canonicalType, side])
}

// ---------------------------------------------------------------------------
// Phase 6B — workspace-scoped CRE knowledge graph.
// Canonical rows are assertions. Observations are immutable evidence.
// Workspace checks across foreign keys are enforced in lib/entities.
// Partial unique indexes and the graph_edge view live in prisma/sql/phase6b.sql
// because Prisma db push does not emit them.
// ---------------------------------------------------------------------------

enum EntityLifecycle {
  ACTIVE
  INACTIVE
  MERGED
}

enum AssetType {
  OFFICE
  RETAIL
  INDUSTRIAL
  MULTIFAMILY
  MIXED_USE
  LAND
  OTHER
  UNKNOWN
}

enum PersonIdentifierKind {
  EMAIL
  PHONE
  LINKEDIN
}

enum CompanyIdentifierKind {
  DOMAIN
  EMAIL_DOMAIN
}

enum ObservationSourceKind {
  DOCUMENT_PAGE
  MESSAGE
  MANUAL
}

enum ObservedEntityType {
  PERSON
  COMPANY
  PROPERTY
}

enum AffiliationKind {
  UNKNOWN
  STAFF
  BROKER
  EXECUTIVE
  FOUNDER
  COUNSEL
  PROPERTY_MANAGER
}

enum PropertyStakePredicate {
  OWNS
  MANAGES
  OCCUPIES
  DEVELOPED
  LENDS_ON
}

enum ParticipationRole {
  TENANT
  LANDLORD
  SUBTENANT
  SUBLANDLORD
  TENANT_BROKER
  LANDLORD_BROKER
  TENANT_BROKERAGE
  LANDLORD_BROKERAGE
  LENDER
  COUNSEL
  PROPERTY_MANAGER
  GUARANTOR
  OTHER
}

enum RelationshipPredicate {
  WORKS_AT
  OWNS
  MANAGES
  OCCUPIES
  DEVELOPED
  LENDS_ON
  PARTICIPATES_AS
  CONCERNS_PROPERTY
}

enum AssertionStatus {
  ASSERTED
  RETIRED
}

enum AssertionSource {
  OBSERVATION
  MANUAL
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
  UNKNOWN
}

enum ObservationDispositionValue {
  ACCEPTED
  REJECTED
}

enum DispositionActor {
  USER
  SYSTEM
}

enum ResolutionMethod {
  MANUAL
  DETERMINISTIC
  MODEL
}

enum ResolutionLinkStatus {
  ACCEPTED
  REJECTED
  SUPERSEDED
}

/// Review state for a proposed identity. Acceptance is never automatic.
enum ResolutionCandidateDecision {
  PENDING
  ACCEPTED
  REJECTED
}

/// Human review of one relationship observation. Absence of a row means the
/// observation is still pending or blocked. Blocked is computed from endpoint
/// resolution and is not stored, so it cannot go stale.
enum RelationshipPromotionDecision {
  APPROVED
  REJECTED
}

/// No authenticated user exists. This is a manual review source, not an account.
enum PromotionActor {
  MANUAL_REVIEW
}

enum MergeEntityType {
  PERSON
  COMPANY
  PROPERTY
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  /// Null until a reviewer identifies the firm. Phase 6B does not infer it.
  firmCompanyId String?
  createdAt     DateTime @default(now())

  firmCompany                  Company?                   @relation("WorkspaceFirm", fields: [firmCompanyId], references: [id])
  deals                        Deal[]
  people                       Person[]
  companies                    Company[]
  properties                   Property[]
  personAliases                PersonAlias[]
  personIdentifiers            PersonIdentifier[]
  companyAliases               CompanyAlias[]
  companyIdentifiers           CompanyIdentifier[]
  propertyAliases              PropertyAlias[]
  externalIdentifiers          ExternalIdentifier[]
  entityObservations           EntityObservation[]
  relationshipObservations     RelationshipObservation[]
  resolutionLinks              EntityResolutionLink[]
  merges                       CanonicalMerge[]
  employments                  Employment[]
  propertyStakes               PropertyStake[]
  dealParticipations           DealParticipation[]
  graphExtractionRuns          GraphExtractionRun[]
  resolutionCandidates         EntityResolutionCandidate[]
  relationshipPromotions       RelationshipPromotion[]

  @@index([firmCompanyId])
}

model Person {
  id                 String          @id @default(cuid())
  workspaceId        String
  canonicalName      String
  firstName          String?
  middleName         String?
  lastName           String?
  primaryTitle       String?
  status             EntityLifecycle @default(ACTIVE)
  mergedIntoPersonId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace      Workspace            @relation(fields: [workspaceId], references: [id])
  mergedInto     Person?              @relation("PersonMerge", fields: [mergedIntoPersonId], references: [id])
  mergedFrom     Person[]             @relation("PersonMerge")
  aliases        PersonAlias[]
  identifiers    PersonIdentifier[]
  employments    Employment[]
  participations DealParticipation[]
  externalIdentifiers ExternalIdentifier[]
  resolutionLinks EntityResolutionLink[]
  resolutionCandidates EntityResolutionCandidate[]

  @@index([workspaceId, status])
  @@index([mergedIntoPersonId])
}

model PersonAlias {
  id              String @id @default(cuid())
  workspaceId     String
  personId        String
  alias           String
  normalizedAlias String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  person    Person    @relation(fields: [personId], references: [id])

  @@unique([personId, normalizedAlias])
  @@index([workspaceId, normalizedAlias])
}

model PersonIdentifier {
  id              String               @id @default(cuid())
  workspaceId     String
  personId        String
  kind            PersonIdentifierKind
  value           String
  normalizedValue String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  person    Person    @relation(fields: [personId], references: [id])

  @@unique([workspaceId, kind, normalizedValue])
  @@index([personId])
}

model Company {
  id                  String          @id @default(cuid())
  workspaceId         String
  canonicalName       String
  legalName           String?
  website             String?
  primaryDomain       String?
  status              EntityLifecycle @default(ACTIVE)
  mergedIntoCompanyId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  workspace         Workspace             @relation(fields: [workspaceId], references: [id])
  mergedInto        Company?              @relation("CompanyMerge", fields: [mergedIntoCompanyId], references: [id])
  mergedFrom        Company[]             @relation("CompanyMerge")
  firmFor           Workspace[]           @relation("WorkspaceFirm")
  aliases           CompanyAlias[]
  identifiers       CompanyIdentifier[]
  employments       Employment[]
  stakes            PropertyStake[]
  participations    DealParticipation[]   @relation("ParticipationCompany")
  representedIn     DealParticipation[]   @relation("ParticipationPrincipal")
  externalIdentifiers ExternalIdentifier[]
  resolutionLinks   EntityResolutionLink[]
  resolutionCandidates EntityResolutionCandidate[]

  @@index([workspaceId, status])
  @@index([workspaceId, primaryDomain])
  @@index([mergedIntoCompanyId])
}

model CompanyAlias {
  id              String @id @default(cuid())
  workspaceId     String
  companyId       String
  alias           String
  normalizedAlias String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, normalizedAlias])
  @@index([workspaceId, normalizedAlias])
}

model CompanyIdentifier {
  id              String                @id @default(cuid())
  workspaceId     String
  companyId       String
  kind            CompanyIdentifierKind
  value           String
  normalizedValue String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([workspaceId, kind, normalizedValue])
  @@index([companyId])
}

model Property {
  id                   String          @id @default(cuid())
  workspaceId          String
  canonicalName        String
  addressLine1         String?
  addressLine2         String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?
  assetType            AssetType       @default(UNKNOWN)
  status               EntityLifecycle @default(ACTIVE)
  mergedIntoPropertyId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  mergedInto  Property?            @relation("PropertyMerge", fields: [mergedIntoPropertyId], references: [id])
  mergedFrom  Property[]           @relation("PropertyMerge")
  aliases     PropertyAlias[]
  stakes      PropertyStake[]
  deals       Deal[]
  externalIdentifiers ExternalIdentifier[]
  resolutionLinks EntityResolutionLink[]
  resolutionCandidates EntityResolutionCandidate[]

  @@index([workspaceId, status])
  @@index([workspaceId, city, region])
  @@index([mergedIntoPropertyId])
}

model PropertyAlias {
  id              String @id @default(cuid())
  workspaceId     String
  propertyId      String
  alias           String
  normalizedAlias String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  property  Property  @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, normalizedAlias])
  @@index([workspaceId, normalizedAlias])
}

/// Public or vendor id. Unique per workspace so a shared id cannot bridge firms.
model ExternalIdentifier {
  id          String   @id @default(cuid())
  workspaceId String
  scheme      String
  value       String
  personId    String?
  companyId   String?
  propertyId  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  person    Person?   @relation(fields: [personId], references: [id])
  company   Company?  @relation(fields: [companyId], references: [id])
  property  Property? @relation(fields: [propertyId], references: [id])

  @@unique([workspaceId, scheme, value])
  @@index([personId])
  @@index([companyId])
  @@index([propertyId])
}

/// Immutable mention. No canonical foreign key and no updatedAt.
model EntityObservation {
  id                  String                    @id @default(cuid())
  workspaceId         String
  observedType        ObservedEntityType
  surfaceForm         String
  normalizedName      String
  title               String?
  email               String?
  phone               String?
  domain              String?
  addressLine1        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?
  rawAttributes       Json?
  sourceKind          ObservationSourceKind
  dealId              String?
  documentId          String?
  documentPageId      String?
  messageId           String?
  evidenceQuote       String
  evidenceStartOffset Int?
  evidenceEndOffset   Int?
  provenanceStatus    EvidenceProvenanceStatus?
  sourceLocation      String?
  extractionConfidence Float?
  extractor           String
  extractorVersion    String
  graphExtractionRunId String?
  createdAt           DateTime                  @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  graphExtractionRun GraphExtractionRun? @relation(fields: [graphExtractionRunId], references: [id], onDelete: Restrict)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentPage DocumentPage? @relation(fields: [documentPageId], references: [id], onDelete: Restrict)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Restrict)
  resolutionLinks EntityResolutionLink[]
  dispositions ObservationDisposition[]
  priorSupersessions ObservationSupersession[] @relation("SupersedePriorEntity")
  successorSupersessions ObservationSupersession[] @relation("SupersedeSuccessorEntity")
  relationshipSubjects RelationshipObservation[] @relation("RelationshipSubject")
  relationshipObjects RelationshipObservation[] @relation("RelationshipObject")
  relationshipPrincipals RelationshipObservation[] @relation("RelationshipPrincipal")
  resolutionCandidates EntityResolutionCandidate[]

  @@index([workspaceId, observedType, normalizedName])
  @@index([workspaceId, email])
  @@index([workspaceId, domain])
  @@index([documentPageId])
  @@index([dealId])
  @@index([documentId])
  @@index([messageId])
  @@index([graphExtractionRunId])
}

/// Immutable relationship claim. Endpoints are observations, not canonical ids.
model RelationshipObservation {
  id                     String                 @id @default(cuid())
  workspaceId            String
  predicate              RelationshipPredicate
  subjectObservationId   String
  objectObservationId    String?
  participationRole      ParticipationRole?
  roleLabel              String?
  affiliationKind        AffiliationKind?
  principalObservationId String?
  contextDealId          String?
  statedValidFrom        DateTime?
  statedValidTo          DateTime?
  statedTitle            String?
  sourceKind             ObservationSourceKind
  dealId                 String?
  documentId             String?
  documentPageId         String?
  messageId              String?
  evidenceQuote          String
  evidenceStartOffset    Int?
  evidenceEndOffset      Int?
  provenanceStatus       EvidenceProvenanceStatus?
  sourceLocation         String?
  extractionConfidence   Float?
  extractor              String
  extractorVersion       String
  graphExtractionRunId   String?
  createdAt              DateTime               @default(now())

  workspace            Workspace            @relation(fields: [workspaceId], references: [id])
  graphExtractionRun   GraphExtractionRun?  @relation(fields: [graphExtractionRunId], references: [id], onDelete: Restrict)
  subjectObservation   EntityObservation    @relation("RelationshipSubject", fields: [subjectObservationId], references: [id], onDelete: Restrict)
  objectObservation    EntityObservation?   @relation("RelationshipObject", fields: [objectObservationId], references: [id], onDelete: Restrict)
  principalObservation EntityObservation?   @relation("RelationshipPrincipal", fields: [principalObservationId], references: [id], onDelete: Restrict)
  deal                 Deal?                @relation("RelationshipObservationDeal", fields: [dealId], references: [id], onDelete: Restrict)
  contextDeal          Deal?                @relation("RelationshipObservationContextDeal", fields: [contextDealId], references: [id], onDelete: Restrict)
  document             Document?            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentPage         DocumentPage?        @relation(fields: [documentPageId], references: [id], onDelete: Restrict)
  message              Message?             @relation(fields: [messageId], references: [id], onDelete: Restrict)
  dispositions         ObservationDisposition[]
  priorSupersessions   ObservationSupersession[] @relation("SupersedePriorRelationship")
  successorSupersessions ObservationSupersession[] @relation("SupersedeSuccessorRelationship")
  employmentSupports   EmploymentSupport[]
  propertyStakeSupports PropertyStakeSupport[]
  dealParticipationSupports DealParticipationSupport[]
  promotion RelationshipPromotion?

  @@index([workspaceId, predicate])
  @@index([subjectObservationId])
  @@index([objectObservationId])
  @@index([contextDealId])
  @@index([documentPageId])
  @@index([documentId])
  @@index([dealId])
  @@index([graphExtractionRunId])
}

/// One immutable observation set for a document, extractor contract, and model.
/// A later extractor version inserts a new run. It does not overwrite an earlier one.
model GraphExtractionRun {
  id                 String                @id @default(cuid())
  workspaceId        String
  documentId         String
  extractor          String
  extractorVersion   String
  model              String
  status             GraphExtractionStatus
  failureCode        String?
  failureReason      String?
  entityCount        Int                   @default(0)
  relationshipCount  Int                   @default(0)
  rejectedCount      Int                   @default(0)
  diagnostics        Json?
  createdAt          DateTime              @default(now())
  completedAt        DateTime?

  workspace                Workspace                 @relation(fields: [workspaceId], references: [id])
  document                 Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityObservations       EntityObservation[]
  relationshipObservations RelationshipObservation[]

  @@unique([documentId, extractor, extractorVersion, model])
  @@index([workspaceId])
  @@index([documentId])
}

model ObservationDisposition {
  id                        String                      @id @default(cuid())
  entityObservationId       String?
  relationshipObservationId String?
  disposition               ObservationDispositionValue
  actor                     DispositionActor
  note                      String?
  createdAt                 DateTime                    @default(now())

  entityObservation       EntityObservation?       @relation(fields: [entityObservationId], references: [id])
  relationshipObservation RelationshipObservation? @relation(fields: [relationshipObservationId], references: [id])

  @@index([entityObservationId, createdAt])
  @@index([relationshipObservationId, createdAt])
}

model ObservationSupersession {
  id                                 String   @id @default(cuid())
  priorEntityObservationId           String?
  successorEntityObservationId       String?
  priorRelationshipObservationId     String?
  successorRelationshipObservationId String?
  createdAt                          DateTime @default(now())

  priorEntity           EntityObservation?       @relation("SupersedePriorEntity", fields: [priorEntityObservationId], references: [id])
  successorEntity       EntityObservation?       @relation("SupersedeSuccessorEntity", fields: [successorEntityObservationId], references: [id])
  priorRelationship     RelationshipObservation? @relation("SupersedePriorRelationship", fields: [priorRelationshipObservationId], references: [id])
  successorRelationship RelationshipObservation? @relation("SupersedeSuccessorRelationship", fields: [successorRelationshipObservationId], references: [id])

  @@index([priorEntityObservationId])
  @@index([priorRelationshipObservationId])
}

/// Append-only mention-to-canonical decision. Phase 6B stores the table and does not resolve.
model EntityResolutionLink {
  id                   String               @id @default(cuid())
  workspaceId          String
  entityObservationId  String
  personId             String?
  companyId            String?
  propertyId           String?
  method               ResolutionMethod
  resolutionConfidence Float?
  status               ResolutionLinkStatus
  createdAt            DateTime             @default(now())
  supersededAt         DateTime?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  observation EntityObservation @relation(fields: [entityObservationId], references: [id])
  person      Person?           @relation(fields: [personId], references: [id])
  company     Company?          @relation(fields: [companyId], references: [id])
  property    Property?         @relation(fields: [propertyId], references: [id])
  resolutionCandidate EntityResolutionCandidate?

  @@index([entityObservationId, status])
  @@index([personId])
  @@index([companyId])
  @@index([propertyId])
  @@index([workspaceId])
}

/// Proposed identity for one observation. Phase 7B stores the proposal and the
/// human decision. It does not create canonical entities, aliases, or edges.
/// Exactly one of the candidate foreign keys is set. Create-new is not a row.
model EntityResolutionCandidate {
  id                  String                      @id @default(cuid())
  workspaceId         String
  entityObservationId String
  candidatePersonId   String?
  candidateCompanyId  String?
  candidatePropertyId String?
  score               Float
  features            Json
  positiveReasons     Json
  negativeReasons     Json
  temporalNotes       Json
  decision            ResolutionCandidateDecision @default(PENDING)
  decisionReason      String?
  createdAt           DateTime                    @default(now())
  decidedAt           DateTime?
  resolutionLinkId    String?                     @unique

  workspace      Workspace              @relation(fields: [workspaceId], references: [id])
  observation    EntityObservation      @relation(fields: [entityObservationId], references: [id])
  person         Person?                @relation(fields: [candidatePersonId], references: [id])
  company        Company?               @relation(fields: [candidateCompanyId], references: [id])
  property       Property?              @relation(fields: [candidatePropertyId], references: [id])
  resolutionLink EntityResolutionLink?  @relation(fields: [resolutionLinkId], references: [id])

  @@index([workspaceId, entityObservationId, decision])
  @@index([entityObservationId])
  @@index([candidatePersonId])
  @@index([candidateCompanyId])
  @@index([candidatePropertyId])
}

model CanonicalMerge {
  id          String          @id @default(cuid())
  workspaceId String
  entityType  MergeEntityType
  sourceId    String
  targetId    String
  reason      String?
  createdAt   DateTime        @default(now())
  undoneAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, entityType, sourceId])
  @@index([targetId])
}

model Employment {
  id                 String          @id @default(cuid())
  workspaceId        String
  personId           String
  companyId          String
  affiliationKind    AffiliationKind @default(UNKNOWN)
  titleAtTime        String?
  validFrom          DateTime?
  validTo            DateTime?
  validFromPrecision DatePrecision   @default(UNKNOWN)
  validToPrecision   DatePrecision   @default(UNKNOWN)
  status             AssertionStatus @default(ASSERTED)
  assertionSource    AssertionSource
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id])
  person    Person              @relation(fields: [personId], references: [id])
  company   Company             @relation(fields: [companyId], references: [id])
  supports  EmploymentSupport[]
  promotions RelationshipPromotion[]

  @@index([workspaceId, companyId, status])
  @@index([workspaceId, personId, status])
}

model EmploymentSupport {
  id                        String   @id @default(cuid())
  employmentId              String
  relationshipObservationId String
  createdAt                 DateTime @default(now())

  employment              Employment              @relation(fields: [employmentId], references: [id])
  relationshipObservation RelationshipObservation @relation(fields: [relationshipObservationId], references: [id])

  @@unique([employmentId, relationshipObservationId])
  @@index([relationshipObservationId])
}

model PropertyStake {
  id                 String                 @id @default(cuid())
  workspaceId        String
  companyId          String
  propertyId         String
  predicate          PropertyStakePredicate
  validFrom          DateTime?
  validTo            DateTime?
  validFromPrecision DatePrecision          @default(UNKNOWN)
  validToPrecision   DatePrecision          @default(UNKNOWN)
  status             AssertionStatus        @default(ASSERTED)
  assertionSource    AssertionSource
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id])
  company   Company                @relation(fields: [companyId], references: [id])
  property  Property               @relation(fields: [propertyId], references: [id])
  supports  PropertyStakeSupport[]
  promotions RelationshipPromotion[]

  @@index([workspaceId, propertyId, predicate, status])
  @@index([workspaceId, companyId, predicate, status])
}

model PropertyStakeSupport {
  id                        String   @id @default(cuid())
  propertyStakeId           String
  relationshipObservationId String
  createdAt                 DateTime @default(now())

  stake                   PropertyStake           @relation(fields: [propertyStakeId], references: [id])
  relationshipObservation RelationshipObservation @relation(fields: [relationshipObservationId], references: [id])

  @@unique([propertyStakeId, relationshipObservationId])
  @@index([relationshipObservationId])
}

model DealParticipation {
  id                  String            @id @default(cuid())
  workspaceId         String
  dealId              String
  role                ParticipationRole
  roleLabel           String?
  personId            String?
  companyId           String?
  representsCompanyId String?
  validFrom           DateTime?
  validTo             DateTime?
  validFromPrecision  DatePrecision     @default(UNKNOWN)
  validToPrecision    DatePrecision     @default(UNKNOWN)
  status              AssertionStatus   @default(ASSERTED)
  assertionSource     AssertionSource
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id])
  deal       Deal                        @relation(fields: [dealId], references: [id])
  person     Person?                     @relation(fields: [personId], references: [id])
  company    Company?                    @relation("ParticipationCompany", fields: [companyId], references: [id])
  represents Company?                    @relation("ParticipationPrincipal", fields: [representsCompanyId], references: [id])
  supports   DealParticipationSupport[]
  promotions RelationshipPromotion[]

  @@index([workspaceId, dealId, role])
  @@index([personId, role])
  @@index([companyId, role])
  @@index([representsCompanyId])
}

model DealParticipationSupport {
  id                        String   @id @default(cuid())
  dealParticipationId       String
  relationshipObservationId String
  createdAt                 DateTime @default(now())

  participation           DealParticipation       @relation(fields: [dealParticipationId], references: [id])
  relationshipObservation RelationshipObservation @relation(fields: [relationshipObservationId], references: [id])

  @@unique([dealParticipationId, relationshipObservationId])
  @@index([relationshipObservationId])
}

/// Current human decision for one immutable relationship observation.
/// Canonical assertion ids are set only when the decision is APPROVED.
model RelationshipPromotion {
  id                        String                        @id @default(cuid())
  workspaceId               String
  relationshipObservationId String                        @unique
  decision                  RelationshipPromotionDecision
  reviewReason              String?
  reviewedAt                DateTime
  actor                     PromotionActor                @default(MANUAL_REVIEW)
  employmentId              String?
  propertyStakeId           String?
  dealParticipationId       String?
  /// Set when CONCERNS_PROPERTY promotion linked this deal to a property.
  linkedDealId              String?
  createdAt                 DateTime                      @default(now())

  workspace               Workspace                @relation(fields: [workspaceId], references: [id])
  relationshipObservation RelationshipObservation @relation(fields: [relationshipObservationId], references: [id])
  employment              Employment?              @relation(fields: [employmentId], references: [id])
  propertyStake           PropertyStake?          @relation(fields: [propertyStakeId], references: [id])
  dealParticipation       DealParticipation?      @relation(fields: [dealParticipationId], references: [id])
  linkedDeal              Deal?                    @relation(fields: [linkedDealId], references: [id])

  @@index([workspaceId, decision])
  @@index([employmentId])
  @@index([propertyStakeId])
  @@index([dealParticipationId])
  @@index([linkedDealId])
}
