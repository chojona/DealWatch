# Local SQLite database used by Prisma.
DATABASE_URL="file:./dev.db"

# Required for email-thread and negotiation-term extraction.
# Create a free key in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Optional model overrides. Both default to the free-tier Gemini Flash model.
DEALWATCH_ANALYSIS_MODEL="gemini-3.8-flash"
DEALWATCH_NEGOTIATION_MODEL="gemini-3.8-flash"

# Set to 1 only when intentionally running tests that call the Gemini API.
RUN_DEALWATCH_INTEGRATION_TESTS="0"
