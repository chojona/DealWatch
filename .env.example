# Local SQLite database used by Prisma
DATABASE_URL="file:./dev.db"

# ============================================
# AI PROVIDER
# ============================================

DEALWATCH_AI_PROVIDER="openai"

# ============================================
# API KEYS
# ============================================

# Optional — keep only if you want Gemini available for future benchmarks
GEMINI_API_KEY="YOUR_REAL_GEMINI_API_KEY"

# Required for OpenAI extraction
OPENAI_API_KEY="YOUR_REAL_OPENAI_API_KEY"

# ============================================
# MODELS
# ============================================

# Email / obligation extraction
DEALWATCH_ANALYSIS_MODEL="gpt-5-nano"

# CRE negotiation intelligence
DEALWATCH_NEGOTIATION_MODEL="gpt-5.4-mini"

# ============================================
# EVALUATION
# ============================================

# No Gemini free-tier pacing needed with OpenAI
DEALWATCH_EVAL_REQUEST_INTERVAL_MS="0"

# Enable only when intentionally running live API integration tests
RUN_DEALWATCH_INTEGRATION_TESTS="0"